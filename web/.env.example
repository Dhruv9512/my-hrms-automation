# Copy to .env.local for local dev; add the same in Vercel -> Project -> Settings -> Environment Variables
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
ENCRYPTION_KEY=            # openssl rand -base64 32   (never change after users register)
SESSION_SECRET=            # openssl rand -base64 48
CRON_SECRET=               # openssl rand -hex 24      (cron-job.org sends it as Bearer token)
ADMIN_EMAILS=dhruv.sharma@amilekconsultancy.com
APP_URL=https://your-app.vercel.app
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DRY_RUN=true               # set to false for REAL checkouts
HRMS_API=https://hrms-amilek-wrdu.onrender.com
TARGET_MINUTES=480
